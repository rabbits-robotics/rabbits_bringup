<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rabbits_bringup</name>
  <version>0.0.0</version>
  <description>機体を動かすための横断 launch（実機、偽ファームでの可視化）と rviz 設定</description>
  <maintainer email="kota0314yama@gmail.com">kota0314</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rabbits_bridge</exec_depend>
  <exec_depend>rabbits_description</exec_depend>
  <exec_depend>rabbits_interface</exec_depend>
  <exec_depend>rabbits_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
